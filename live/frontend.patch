+import { useEffect, useState } from "react";
+import styled from "styled-components";
+import { Settings } from "luxon";
+import { t } from "@shared/src/i18n";
+import c from "@/config";
+import { useAppSelector } from "@/redux/hooks";
+import { useFormatPenalty } from "@/services/displayUtils";
+import { VerdictLabel } from "../../atoms/ContestLabels";
+import { QueueWrap } from "./queue/QueueContainer";
+import { QueueHeader } from "./queue/QueueHeader";
+import { StyledQueueRow, QueueTeamNameLabel, QueueProblemLabel } from "./queue/QueueRow";
+import { ScoreboardRankLabel, ScoreboardRowName, ScoreboardRowWrap } from "./scoreboard/ScoreboardRow";
+import { StatisticsWrap, Header, Title, Caption } from "./Statistics";
+
+const QueuePanel = styled(QueueWrap).attrs({ variant: "vertical" as const, hasFeatured: false })`
+    height: auto; max-height: 100%; overflow: hidden; color: ${c.GLOBAL_TEXT_COLOR};
+`;
+const CutoffRow = styled(ScoreboardRowWrap).attrs({ needPenalty: true, nProblems: 0 })`
+    color: ${c.SCOREBOARD_TEXT_COLOR};
+    grid-template-columns: ${c.SCOREBOARD_CELL_PLACE_SIZE} minmax(0, 1fr) ${c.SCOREBOARD_CELL_POINTS_SIZE} auto;
+`;
+const Detail = styled.div`
+    color: ${c.GLOBAL_TEXT_COLOR};
+    display: flex; flex-wrap: wrap; align-items: center; gap: ${c.QUEUE_GAP};
+    font-family: ${c.GLOBAL_DEFAULT_FONT_FAMILY}; font-size: ${c.QUEUE_ROW_FONT_SIZE};
+`;
+const ResultCell = styled(VerdictLabel).attrs({ align: "center", fontSize: c.QUEUE_ROW_FONT_SIZE })`
+    width: ${c.QUEUE_ROW_STATUS_LABEL_WIDTH}; align-self: stretch; flex-shrink: 0;
+`;
+function BodyRow({ name, time, problem, code }: { name: string; time: number | null; problem: string; code?: string }) {
+    const info = useAppSelector((state) => state.contestInfo.info?.problems.find((p) => p.letter === problem));
+    return <StyledQueueRow>
+        <QueueTeamNameLabel text={name} />
+        {time !== null && <span>{Math.floor(time / 60000)}′</span>}
+        <QueueProblemLabel letter={problem} problemColor={info?.color} isFts={!code} />
+        {code && <ResultCell text={verdictName(code)} color={code === "AC" ? c.VERDICT_OK :
+            code === "FROZEN" || code === "PENDING" ? c.VERDICT_UNKNOWN : c.VERDICT_NOK} />}
+    </StyledQueueRow>;
+}
+interface News { problem: string; teams: string[]; time: number | null; expires: number }
+export function FirstSolveCard({ widgetData }: { widgetData: { items: News[] } }) {
+    const [now, setNow] = useState(Settings.now());
+    useEffect(() => {
+        const timer = setInterval(() => setNow(Settings.now()), 500);
+        return () => clearInterval(timer);
+    }, []);
+    const items = widgetData.items.filter((item) => item.expires > now);
+    if (!items.length) return null;
+    const offset = Math.floor(now / 3000) % Math.ceil(items.length / 3) * 3;
+    return <QueuePanel as="section" aria-label={t("First solve flash")}>
+        <QueueHeader title={t("First solve flash")} caption="" />
+        {items.slice(offset, offset + 3).map((item) => <BodyRow key={item.problem} problem={item.problem}
+            name={item.teams.join(" · ") || t("First solve withdrawn")} time={item.time} />)}
+    </QueuePanel>;
+}
+interface LineTeam { rank: number; name: string; solved: number; penalty: number }
+interface Medal { group: string; medal: string; citation?: string; inside: LineTeam | null; outside: LineTeam | null }
+export function MedalCard({ widgetData: { data } }: { widgetData: { data: Medal } }) {
+    const { inside, outside } = data;
+    const formatPenalty = useFormatPenalty();
+    const effect = c.AWARD_EFFECTS[data.medal + "-medal"];
+    const title = t("Medal cutoff") + " · " + (data.citation || t(data.medal + " medal"));
+    return <QueuePanel as="section" aria-label={t("Medal cutoff")}>
+        <QueueHeader title={title} caption="" />
+        <Detail>{data.group === "all" ? t("All teams") : data.group}</Detail>
+        {[inside, outside].map((team, i) => team && <CutoffRow key={i}>
+            <ScoreboardRankLabel rank={team.rank} effects={!i && effect ? [effect] : []} />
+            <ScoreboardRowName text={team.name} />
+            <span>{team.solved}</span><span>{formatPenalty(team.penalty)}</span>
+        </CutoffRow>)}
+        <Detail>{inside && outside
+            ? t("Score gap") + " " + (inside.solved - outside.solved) + " · " + t("Penalty difference") + " " +
+                (outside.penalty >= inside.penalty ? "+" : "−") + formatPenalty(Math.abs(outside.penalty - inside.penalty))
+            : inside ? t("No next eligible team") : t("No medal cutoff yet")}</Detail>
+    </QueuePanel>;
+}
+interface Focus { problem: string; solved: number; attempted: number; submissions: number; verdicts: Record<string, number>;
+    recent: { team: string; verdict: string; time: number }[] }
+const verdictName = (code: string) => code === "FROZEN" ? t("Frozen") : code === "PENDING" ? t("Pending") : code;
+export function ProblemCard({ widgetData: { data } }: { widgetData: { data: Focus } }) {
+    return <StatisticsWrap as="section" aria-label={t("Problem focus")}>
+        <Header><Title role="heading" aria-level={2}>{t("Problem focus")} · {data.problem}</Title><Caption /></Header>
+        <Detail><span>{t("Attempted teams")} {data.attempted}</span><span>{t("Solved teams")} {data.solved}</span>
+            <span>{t("Submissions")} {data.submissions}</span></Detail>
+        <Detail>{Object.entries(data.verdicts).map(([code, count]) => <span key={code}>{verdictName(code)} {count}</span>)}</Detail>
+        {data.recent.map((run, index) => <BodyRow key={index} problem={data.problem} name={run.team} time={run.time} code={run.verdict} />)}
+    </StatisticsWrap>;
+}
+FirstSolveCard.zIndex = MedalCard.zIndex = ProblemCard.zIndex = 4;
