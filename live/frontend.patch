+type Panel = "showRanking" | "showProblems" | "showSchools" | "showRecent" | "showCharts";
+const panels: [Panel, string][] = [
+    ["showRanking", "Standings"],
+    ["showProblems", "Problems"],
+    ["showSchools", "Schools"],
+    ["showRecent", "Recent accepts"],
+    ["showCharts", "Charts"],
+];
+
+export type ContestOverviewManagerProps = {
+    service: AbstractSingleWidgetService<ContestOverviewSettings>;
+    isShown: boolean;
+    settings: ContestOverviewSettings;
+    setSettings: Dispatch<SetStateAction<ContestOverviewSettings>>;
+};
+
+const ContestOverviewManager = ({ service, isShown, settings, setSettings }: ContestOverviewManagerProps) => {
+    // Edits made while it is on air go out by themselves (only edits: not the settings loaded from the server).
+    const edited = useRef(false);
+    const set = <K extends keyof ContestOverviewSettings>(key: K, value: ContestOverviewSettings[K]) => {
+        edited.current = true;
+        setSettings((current) => ({ ...current, [key]: value }));
+    };
+    useEffect(() => {
+        if (!isShown || !edited.current) return;
+        const timer = setTimeout(() => { edited.current = false; service.showWithSettings(settings); }, 400);
+        return () => clearTimeout(timer);
+    }, [settings, isShown, service]);
+    return (
+        <>
+            <Table align="center" size="small">
+                <TableBody>
+                    <TableRow>
+                        <SlimTableCell>{t("Screen language")}</SlimTableCell>
+                        <SlimTableCell>
+                            <Select
+                                size="small"
+                                value={settings.language}
+                                onChange={(event) => set("language", event.target.value as ContestOverviewSettings["language"])}
+                            >
+                                <MenuItem value="zh">{t("Chinese")}</MenuItem>
+                                <MenuItem value="en">{t("English")}</MenuItem>
+                            </Select>
+                        </SlimTableCell>
+                    </TableRow>
+                    <TableRow>
+                        <SlimTableCell>{t("Title")}</SlimTableCell>
+                        <SlimTableCell>
+                            <TextField
+                                size="small"
+                                fullWidth
+                                value={settings.title}
+                                placeholder={t("Contest title")}
+                                inputProps={{ maxLength: 100 }}
+                                onChange={(event) => set("title", event.target.value)}
+                            />
+                        </SlimTableCell>
+                    </TableRow>
+                    <TableRow>
+                        <SlimTableCell>{t("Teams in the standings")}</SlimTableCell>
+                        <SlimTableCell>
+                            <Select
+                                size="small"
+                                value={settings.topTeams}
+                                onChange={(event) => set("topTeams", Number(event.target.value))}
+                            >
+                                {[3, 5, 6, 8, 10].map((count) => (
+                                    <MenuItem key={count} value={count}>{count}</MenuItem>
+                                ))}
+                            </Select>
+                        </SlimTableCell>
+                    </TableRow>
+                    <TableRow>
+                        <SlimTableCell>{t("Panels")}</SlimTableCell>
+                        <SlimTableCell>
+                            {panels.map(([key, label]) => (
+                                <FormControlLabel
+                                    key={key}
+                                    control={<Switch checked={settings[key]} onChange={(event) => set(key, event.target.checked)} />}
+                                    label={t(label)}
+                                />
+                            ))}
+                        </SlimTableCell>
+                    </TableRow>
+                </TableBody>
+            </Table>
+            <div>
+                {isShown
+                    ? <Button variant="contained" color="error" sx={{ m: 2 }} onClick={() => service.hide()}>{t("Hide")}</Button>
+                    : <Button variant="contained" sx={{ m: 2 }} onClick={() => service.showWithSettings(settings)}>{t("Show")}</Button>}
+            </div>
+        </>
+    );
+};
+
+export default ContestOverviewManager;
