@@ -0,0 +1,34 @@
+// Hydro: the single-team bottom bar (school card, trend timeline or nothing) a director last chose,
+// shared by the TeamView, Capture and Analytics pages of this browser.
+import { TeamViewBottomBar } from "@shared/api";
+import { useLocalStorageState } from "@admin/utils";
+
+const KEY = "teamView.bottomBar";
+/** Before the bottom bar, the TeamView page had a timeline switch. */
+const LEGACY_TIMELINE_KEY = "teamView.timeLineShown";
+
+const readJson = (key: string): unknown => {
+    try {
+        return JSON.parse(localStorage.getItem(key) ?? "null");
+    } catch {
+        return null;
+    }
+};
+
+export const isBottomBar = (value: unknown): value is TeamViewBottomBar =>
+    value === "card" || value === "timeline" || value === "none";
+
+/** The saved choice; a saved timeline switch carries over, otherwise the school card. */
+export function storedBottomBar(): TeamViewBottomBar {
+    const saved = readJson(KEY);
+    if (isBottomBar(saved)) return saved;
+    const legacy = readJson(LEGACY_TIMELINE_KEY);
+    if (legacy === true) return "timeline";
+    if (legacy === false) return "none";
+    return "card";
+}
+
+export function useBottomBar(): [TeamViewBottomBar, (value: TeamViewBottomBar) => void] {
+    const [value, setValue] = useLocalStorageState<TeamViewBottomBar>(KEY, storedBottomBar());
+    return [isBottomBar(value) ? value : storedBottomBar(), setValue];
+}
