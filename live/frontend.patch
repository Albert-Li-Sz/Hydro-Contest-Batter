+                                            <QueueProblemLabel letter={run.problem} problemColor={run.color} isFts={run.firstSolve} />
+                                            <Cut>
+                                                {run.team}
+                                                {run.firstSolve && <small style={{ color: "#ffd75e", opacity: 1 }}>{t.firstSolve}</small>}
+                                                {run.unofficial && <small>{t.unofficial}</small>}
+                                            </Cut>
+                                            <Num style={{ opacity: 0.7, fontSize: 17 }}>{`${run.minute}${t.minute}`}</Num>
+                                        </Row>
+                                    )) : <Empty>{t.noRecent}</Empty>}
+                                </Rows>
+                            </Panel>
+                        )}
+                    </Side>
+                )}
+            </Main>
+            {settings.showCharts && (
+                <Charts>
+                    <Panel>
+                        <PanelHead>
+                            <h2>{t.trend}</h2>
+                            <span><span style={{ color: "#78aaff", opacity: 1 }}>■</span> {t.submissions} <span style={{ color: c.VERDICT_OK, opacity: 1 }}>■</span> {t.accepted}</span>
+                        </PanelHead>
+                        <TrendChart trend={overview.trend ?? []} />
+                    </Panel>
+                    <Panel>
+                        <PanelHead><h2>{t.histogram}</h2></PanelHead>
+                        <Histogram bins={overview.histogram ?? []} />
+                    </Panel>
+                    <Panel>
+                        <PanelHead><h2>{t.verdicts}</h2></PanelHead>
+                        <Verdicts verdicts={overview.verdicts ?? []} names={t.verdict} />
+                    </Panel>
+                </Charts>
+            )}
+        </Wrap>
+    );
+};
+
+ContestOverview.overrideTimeout = c.SVG_APPEAR_TIME;
+
+export default ContestOverview;
