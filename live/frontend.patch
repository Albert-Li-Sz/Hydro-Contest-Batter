@@ -0,0 +1,255 @@
+import { useEffect, useState } from "react";
+import styled from "styled-components";
+import { t } from "@shared/src/i18n";
+import { MediaType, OrganizationInfo, TeamId, TeamInfo } from "@shared/api";
+import c from "@/config";
+import { useAppSelector } from "@/redux/hooks";
+import { hexToRgb, isShouldUseDarkColor } from "@/utils/colors";
+
+const BANNER_FONT = `"PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", ${c.GLOBAL_DEFAULT_FONT_FAMILY}, sans-serif`;
+
+/** Deep broadcast ICPC blue when using the default theme color; honors custom colors directly. */
+export function bannerColors(baseColor?: string | null): {
+    bg: string;
+    edge: string;
+    darkText: boolean;
+} {
+    const raw = (baseColor || c.CONTEST_COLOR || "#4C83C3").trim();
+    if (raw.toLowerCase() === "#4c83c3") {
+        return {
+            bg: "linear-gradient(90deg, #0b418c 0%, #104ea3 100%)",
+            edge: "#104ea3",
+            darkText: false,
+        };
+    }
+    const darkText = isShouldUseDarkColor(raw);
+    const rgb = hexToRgb(raw);
+    if (!rgb || darkText) {
+        return { bg: raw, edge: raw, darkText };
+    }
+    const deepen = (v: number, factor: number) =>
+        Math.max(0, Math.min(255, Math.round(v * factor)));
+    const left = `rgb(${deepen(rgb.r, 0.78)}, ${deepen(rgb.g, 0.78)}, ${deepen(rgb.b, 0.78)})`;
+    return {
+        bg: `linear-gradient(90deg, ${left} 0%, ${raw} 100%)`,
+        edge: raw,
+        darkText: false,
+    };
+}
+
+const BannerWrap = styled.section<{
+    $bg: string;
+    $darkText: boolean;
+    $fullWidth: boolean;
+}>`
+    width: 100%;
+    height: ${c.TIMELINE_WRAP_HEIGHT}px;
+    box-sizing: border-box;
+    display: flex;
+    align-items: center;
+    gap: 22px;
+    padding: 14px 28px 14px 24px;
+    background: ${(p) => p.$bg};
+    color: ${(p) => (p.$darkText ? "#111827" : "#FFFFFF")};
+    font-family: ${BANNER_FONT};
+    border-radius: ${(p) =>
+        p.$fullWidth
+            ? `${c.TIMELINE_BORDER_RADIUS}`
+            : `${c.TIMELINE_BORDER_RADIUS} 0 0 ${c.TIMELINE_BORDER_RADIUS}`};
+    overflow: hidden;
+    position: relative;
+`;
+
+const LogoBadge = styled.div`
+    width: 112px;
+    height: 112px;
+    flex-shrink: 0;
+    border-radius: 50%;
+    background: #ffffff;
+    padding: 5px;
+    box-sizing: border-box;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.24);
+    overflow: hidden;
+
+    img {
+        width: 100%;
+        height: 100%;
+        object-fit: contain;
+        display: block;
+    }
+`;
+
+const TextColumn = styled.div<{ $compact: boolean }>`
+    flex: 1;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    gap: ${(p) => (p.$compact ? "3px" : "6px")};
+`;
+
+const SchoolLine = styled.div<{ $compact: boolean }>`
+    font-size: ${(p) => (p.$compact ? "31px" : "35px")};
+    font-weight: 700;
+    line-height: 1.18;
+    letter-spacing: 0.01em;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+`;
+
+const TeamLine = styled.div<{ $primary: boolean; $compact: boolean }>`
+    font-size: ${(p) => (p.$primary ? "38px" : p.$compact ? "31px" : "33px")};
+    font-weight: 700;
+    line-height: 1.18;
+    letter-spacing: 0.01em;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+`;
+
+const RosterLine = styled.div<{ $darkText: boolean }>`
+    font-size: 22px;
+    font-weight: 500;
+    line-height: 1.24;
+    color: ${(p) =>
+        p.$darkText ? "rgba(17, 24, 39, 0.85)" : "rgba(255, 255, 255, 0.93)"};
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+`;
+
+const SeatBadge = styled.div`
+    flex-shrink: 0;
+    align-self: flex-start;
+    padding-top: 2px;
+    font-size: 30px;
+    font-weight: 700;
+    line-height: 1.15;
+    letter-spacing: 0.02em;
+    font-variant-numeric: tabular-nums;
+    opacity: 0.96;
+`;
+
+const BannerBackground = styled.div<{ $color: string }>`
+    background-color: ${(p) => p.$color};
+    grid-column: 2 / 2;
+    grid-row: 4 / 4;
+    border-bottom-right-radius: ${c.GLOBAL_BORDER_RADIUS};
+`;
+
+function splitField(value?: string): string[] {
+    if (!value) return [];
+    return value
+        .split(" · ")
+        .map((item) => item.trim())
+        .filter(Boolean);
+}
+
+function logoUrlOf(org?: OrganizationInfo): string | null {
+    if (!org || org.customFields?.hydroMissing === "1") return null;
+    // Only show registered school emblems on the banner (no generic placeholder).
+    if (org.customFields?.hydroLogo !== "1") return null;
+    const image = org.logo?.find(
+        (item): item is MediaType.Image =>
+            item.type === MediaType.Type.Image && Boolean(item.url),
+    );
+    return image?.url ?? null;
+}
+
+export function TeamInfoBannerBackground({ teamId }: { teamId: TeamId }) {
+    const team = useAppSelector(
+        (state) => state.contestInfo.info?.teamsId[teamId],
+    ) as TeamInfo | undefined;
+    const { edge } = bannerColors(team?.color);
+    return <BannerBackground $color={edge} />;
+}
+
+export function TeamInfoBanner({
+    teamId,
+    fullWidth = false,
+}: {
+    teamId: TeamId;
+    fullWidth?: boolean;
+}) {
+    const team = useAppSelector(
+        (state) => state.contestInfo.info?.teamsId[teamId],
+    ) as TeamInfo | undefined;
+    const org = useAppSelector((state) => {
+        const orgId = state.contestInfo.info?.teamsId[teamId]?.organizationId;
+        if (!orgId) return undefined;
+        return state.contestInfo.info?.organizationsId?.[orgId];
+    }) as OrganizationInfo | undefined;
+
+    const logoUrl = logoUrlOf(org);
+    const [logoFailed, setLogoFailed] = useState(false);
+    useEffect(() => {
+        setLogoFailed(false);
+    }, [logoUrl]);
+
+    if (!team) return null;
+
+    const schoolName =
+        org && org.customFields?.hydroMissing !== "1" ? org.displayName : "";
+    const members = splitField(team.customFields?.members);
+    const coaches = splitField(team.customFields?.coaches);
+    const coachSuffix = `(${t("Coach")})`;
+    const rosterParts = [
+        ...members,
+        ...coaches.map((name) => `${name}${coachSuffix}`),
+    ];
+    const roster = rosterParts.join(", ");
+    const rawSeat = (team.customFields?.seat || team.hashTag || "").trim();
+    const seat = rawSeat
+        ? rawSeat.startsWith("#")
+            ? rawSeat
+            : `#${rawSeat}`
+        : "";
+    const { bg, darkText } = bannerColors(team.color);
+    const compact = Boolean(schoolName && roster);
+
+    return (
+        <BannerWrap
+            className="TeamInfoBanner"
+            aria-label={t("School card")}
+            $bg={bg}
+            $darkText={darkText}
+            $fullWidth={fullWidth}
+        >
+            {logoUrl && !logoFailed && (
+                <LogoBadge>
+                    <img
+                        src={logoUrl}
+                        alt={schoolName || team.name}
+                        onError={() => setLogoFailed(true)}
+                    />
+                </LogoBadge>
+            )}
+            <TextColumn $compact={compact}>
+                {schoolName && (
+                    <SchoolLine $compact={compact} title={schoolName}>
+                        {schoolName}
+                    </SchoolLine>
+                )}
+                <TeamLine
+                    $primary={!schoolName}
+                    $compact={compact}
+                    title={team.name}
+                >
+                    {team.name}
+                </TeamLine>
+                {roster && (
+                    <RosterLine $darkText={darkText} title={roster}>
+                        {roster}
+                    </RosterLine>
+                )}
+            </TextColumn>
+            {seat && <SeatBadge>{seat}</SeatBadge>}
+        </BannerWrap>
+    );
+}
+
+export default TeamInfoBanner;
