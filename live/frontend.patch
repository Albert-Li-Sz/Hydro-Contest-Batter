diff --git a/src/frontend/admin-overlay/src/components/ReplayPanel.tsx b/src/frontend/admin-overlay/src/components/ReplayPanel.tsx
new file mode 100644
index 0000000..0874444
--- /dev/null
+++ b/src/frontend/admin-overlay/src/components/ReplayPanel.tsx
@@ -0,0 +1,45 @@
+import { useEffect, useState } from "react";
+import { BASE_URL_BACKEND } from "@admin/config";
+import { Stack } from "@mui/material";
+
+type Clip = { label: string; urls: string[] };
+type Run = { rid: string; team: string; problem: string; videos: { label: string; url: string }[];
+    streams: { stream: string; segments: { url: string; startMs: number }[] }[] };
+
+export default function ReplayPanel({ rid, teamUid }: { rid?: string; teamUid?: string }) {
+    const [open, setOpen] = useState(false);
+    const [runs, setRuns] = useState<Run[]>([]);
+    const [state, setState] = useState("");
+    const [clip, setClip] = useState<Clip | null>(null);
+    const [index, setIndex] = useState(0);
+    useEffect(() => {
+        setClip(null);
+        setIndex(0);
+        setRuns([]);
+        if (!open || (!rid && !teamUid)) return;
+        const abort = new AbortController();
+        setState("正在读取回放…");
+        const filter = new URLSearchParams(rid ? { rid } : { teamUid: teamUid! });
+        fetch(BASE_URL_BACKEND + "/replay?" + filter, { signal: abort.signal, credentials: "same-origin" })
+            .then(async response => {
+                if (!response.ok) throw new Error(String(response.status));
+                return await response.json() as Run[];
+            })
+            .then(data => { if (!abort.signal.aborted) { setRuns(data); setState(data.length ? "" : "暂无可回放的片段"); } })
+            .catch(() => { if (!abort.signal.aborted) setState("读取回放失败，请重新展开"); });
+        return () => abort.abort();
+    }, [open, rid, teamUid]);
+    if (!rid && !teamUid) return null;
+    return <details onToggle={e => setOpen(e.currentTarget.open)}>
+        <summary>提交回放</summary>
+        {state}
+        {open && <Stack spacing={1}>{runs.map(run => {
+            const clips = [...run.videos.map(v => ({ label: v.label, urls: [v.url] })),
+                ...run.streams.map(s => ({ label: s.stream === "screen" ? "屏幕片段" : "摄像头片段",
+                    urls: [...s.segments].sort((a,b) => a.startMs-b.startMs).map(segment => segment.url) }))];
+            return <div key={run.rid}>{run.team} · {run.problem} {clips.filter(c => c.urls.length > 0).map((c,i) =>
+                <button key={i} type="button" onClick={() => { setClip(c); setIndex(0); }}>{c.label}</button>)}</div>;
+        })}{clip && <video key={clip.urls[index]} controls autoPlay playsInline src={clip.urls[index]}
+            style={{maxWidth:"100%",maxHeight:"52vh"}} onEnded={() => { if (index+1 < clip.urls.length) setIndex(index+1); }} />}</Stack>}
+    </details>;
+}
