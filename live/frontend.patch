+    "Failed to load presets": "加载预设失败",
+    "Failed to toggle preset visibility": "切换预设显示失败",
+};
+
+const en: Record<string, string> = Object.fromEntries(
+    Object.entries(zh).map(([english, chinese]) => [chinese, english]),
+);
+
+/** The text in the console's language; `{name}` placeholders are filled from `params`. */
+export function t(text: string, params?: Record<string, string | number | null | undefined>): string {
+    const translated = language === "zh" ? (zh[text] ?? text) : (en[text] ?? text);
+    if (!params) return translated;
+    return translated.replace(/\{(\w+)\}/g, (match, key) => (key in params ? String(params[key] ?? "") : match));
+}
