+
+function TrendChart({ trend }: { trend: NonNullable<Overview["trend"]> }) {
+    const width = 600;
+    const height = 140;
+    const top = Math.max(1, ...trend.map((point) => point.submissions));
+    const last = trend[trend.length - 1]?.minute || 1;
+    const line = (key: "submissions" | "accepted") => trend
+        .map((point, index) => `${index ? "L" : "M"}${((point.minute / last) * width).toFixed(1)},${(height - (point[key] / top) * height).toFixed(1)}`)
+        .join(" ");
+    if (!trend.length) return null;
+    return (
+        <svg viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" style={{ width: "100%", flex: 1, minHeight: 0 }}>
+            <path d={`${line("submissions")} L${width},${height} L0,${height} Z`} fill="rgb(120 170 255 / 18%)" />
+            <path d={line("submissions")} fill="none" stroke="#78aaff" strokeWidth="3" vectorEffect="non-scaling-stroke" />
+            <path d={line("accepted")} fill="none" stroke={c.VERDICT_OK} strokeWidth="3" vectorEffect="non-scaling-stroke" />
+        </svg>
+    );
+}
+
+function Histogram({ bins }: { bins: NonNullable<Overview["histogram"]> }) {
+    const top = Math.max(1, ...bins.map((bin) => bin.teams));
+    return (
+        <div style={{ display: "flex", flex: 1, gap: 4, alignItems: "flex-end", minHeight: 0 }}>
+            {bins.map((bin) => (
