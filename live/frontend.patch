diff --git a/src/frontend/admin-overlay/src/components/pages/CapturePage.tsx b/src/frontend/admin-overlay/src/components/pages/CapturePage.tsx
new file mode 100644
index 0000000..8e572f1
--- /dev/null
+++ b/src/frontend/admin-overlay/src/components/pages/CapturePage.tsx
@@ -0,0 +1,248 @@
+// Hydro: 画面采集 in the director console. Every capture device (a contestant computer), a preview
+// of its screen or webcam, and one click to put it on air: full screen or a quarter of the split
+// screen, as the team view of the team it belongs to. The screen is the default.
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import {
+    Alert,
+    Box,
+    Button,
+    ButtonGroup,
+    Card,
+    CardActions,
+    CardContent,
+    Chip,
+    Container,
+    FormControlLabel,
+    MenuItem,
+    Select,
+    Stack,
+    Switch,
+    TextField,
+    ToggleButton,
+    ToggleButtonGroup,
+    Typography,
+} from "@mui/material";
+import { useSnackbar } from "notistack";
+import { TeamViewBottomBar } from "@shared/api";
+import { BASE_URL_BACKEND } from "@admin/config";
+import { captureClient } from "@admin/services/hydroCapture";
+import { useBottomBar } from "@admin/services/teamViewBottomBar";
+import { t } from "shared-code/i18n";
+
+type Stream = "screen" | "webcam";
+
+interface CaptureDevice {
+    id: string;
+    name: string;
+    seat: string;
+    teamId: string | null;
+    teamName: string;
+    online: boolean;
+    streams: Stream[];
+}
+
+interface CaptureStatus {
+    available: boolean;
+    enabled?: boolean;
+    webcam?: boolean;
+    screenOnAir?: boolean;
+    devices: CaptureDevice[];
+}
+
+const HYDRO_LIVE = (window as unknown as { __HYDRO_LIVE__: { previewCaptureWs?: string } }).__HYDRO_LIVE__;
+const SPLIT = ["TOP_LEFT", "TOP_RIGHT", "BOTTOM_LEFT", "BOTTOM_RIGHT"] as const;
+const MAX_PREVIEWS = 12;
+const SEAT_KEY = `hydro-capture-seat:${location.pathname.split("/live/admin")[0]}`;
+
+let watch: ReturnType<typeof captureClient> | null = null;
+const watcher = () => {
+    watch ||= captureClient(`${location.protocol === "https:" ? "wss" : "ws"}://${location.host}${HYDRO_LIVE.previewCaptureWs}`);
+    return watch;
+};
+
+async function api(path: string, body?: unknown) {
+    const response = await fetch(`${BASE_URL_BACKEND}${path}`, {
+        method: body === undefined ? "GET" : "POST",
+        credentials: "same-origin",
+        headers: { "Content-Type": "application/json", Accept: "application/json" },
+        body: body === undefined ? undefined : JSON.stringify(body),
+    });
+    const data = await response.json().catch(() => null);
+    if (!response.ok || data?.status === "error") throw new Error(data?.message || `HTTP ${response.status}`);
+    return data;
+}
+
+const Preview = ({ device, stream }: { device: string; stream: Stream }) => {
+    const ref = useRef<HTMLVideoElement>(null);
+    const [playing, setPlaying] = useState(false);
+    useEffect(() => {
+        const video = ref.current;
+        if (!video) return;
+        setPlaying(false);
+        return watcher()(device, stream, video, () => setPlaying(true));
+    }, [device, stream]);
+    return (
+        <Box sx={{ position: "relative", background: "#000", aspectRatio: "16 / 9", borderRadius: 1, overflow: "hidden" }}>
+            <video ref={ref} muted autoPlay playsInline style={{ width: "100%", height: "100%", objectFit: "contain", display: "block" }} />
+            {!playing && (
+                <Typography variant="caption" sx={{ position: "absolute", inset: 0, display: "flex", alignItems: "center", justifyContent: "center", color: "#ccc" }}>
+                    {t("Connecting…")}
+                </Typography>
+            )}
+        </Box>
+    );
+};
+
+const CapturePage = () => {
+    const { enqueueSnackbar } = useSnackbar();
+    const [status, setStatus] = useState<CaptureStatus | null>(null);
+    const [stream, setStream] = useState<Stream>("screen");
+    const [bottomBar, setBottomBar] = useBottomBar();
+    const [onlineOnly, setOnlineOnly] = useState(true);
+    const [search, setSearch] = useState("");
+    // The zone a director watches, kept per browser like the capture management page's filter.
+    const [seatPrefix, setSeatPrefix] = useState(() => { try { return localStorage.getItem(SEAT_KEY) || ""; } catch { return ""; } });
+    useEffect(() => { try { localStorage.setItem(SEAT_KEY, seatPrefix); } catch { /* per-browser convenience only */ } }, [seatPrefix]);
+    const [previews, setPreviews] = useState<Set<string>>(new Set());
+
+    const load = useCallback(() => {
+        api("/capture").then(setStatus).catch((error) => setStatus({ available: false, devices: [], ...{ error: error.message } }));
+    }, []);
+    useEffect(() => {
+        load();
+        // Pushed when a device connects, leaves or changes streams; the slow poll catches silent ones.
+        let pushed: ReturnType<typeof setTimeout> | undefined;
+        const unsubscribe = watcher().onDevices(() => { clearTimeout(pushed); pushed = setTimeout(load, 300); });
+        const timer = setInterval(() => { if (!document.hidden) load(); }, 20000);
+        return () => { clearInterval(timer); clearTimeout(pushed); unsubscribe(); };
+    }, [load]);
+    useEffect(() => { if (status && status.webcam === false && stream === "webcam") setStream("screen"); }, [status, stream]);
+
+    const devices = useMemo(() => (status?.devices || []).filter((device) => (!onlineOnly || device.online)
+        && (device.seat || "").toLowerCase().startsWith(seatPrefix.trim().toLowerCase())
+        && (!search.trim() || `${device.name} ${device.seat} ${device.teamName}`.toLowerCase().includes(search.trim().toLowerCase()))), [status, onlineOnly, search, seatPrefix]);
+    /** The zones of the seats, as the floor screen groups them: `A-01` → `A`. */
+    const zones = useMemo(() => [...new Set((status?.devices || []).map((device) => (device.seat || "").replace(/[\s_-]*\d+$/, "")).filter(Boolean))].sort(), [status]);
+
+    const onAir = useCallback(async (device: CaptureDevice, position: "SINGLE" | typeof SPLIT[number]) => {
+        if (!device.teamId) return;
+        const single = position === "SINGLE";
+        const settings = {
+            teamId: device.teamId, mediaTypes: [stream === "screen" ? "screen" : "camera"],
+            showTaskStatus: true, showAchievement: false, showTimeLine: single && bottomBar === "timeline",
+            bottomBar: single ? bottomBar : "none",
+        };
+        try {
+            if (single) await api("/teamView/SINGLE/show_with_settings", settings);
+            else await api(`/splitScreen/${position}/show_with_settings`, settings);
+            enqueueSnackbar(t("{name} is on air", { name: device.teamName || device.name }), { variant: "success" });
+        } catch (error) {
+            enqueueSnackbar(`${t("Failed to put on air")} · ${(error as Error).message}`, { variant: "error" });
+        }
+    }, [stream, bottomBar, enqueueSnackbar]);
+
+    const offAir = useCallback(async () => {
+        try {
+            await api("/teamView/hide", {});
+            await api("/splitScreen/hide", {});
+        } catch (error) {
+            enqueueSnackbar(`${t("Failed to hide ")}${(error as Error).message}`, { variant: "error" });
+        }
+    }, [enqueueSnackbar]);
+
+    const togglePreview = (id: string) => setPreviews((current) => {
+        const next = new Set(current);
+        if (next.has(id)) next.delete(id);
+        else if (next.size < MAX_PREVIEWS) next.add(id);
+        return next;
+    });
+
+    if (status && !status.available) {
+        return <Container maxWidth="md" sx={{ pt: 2 }}><Alert severity="info">{t("Capture is turned off in the plugin settings.")}</Alert></Container>;
+    }
+    const screenBlocked = stream === "screen" && status?.screenOnAir === false;
+    return (
+        <Container maxWidth="xl" sx={{ pt: 2, pb: 4 }}>
+            <Stack direction="row" spacing={2} alignItems="center" flexWrap="wrap" useFlexGap sx={{ mb: 2 }}>
+                <Select size="small" value={stream} onChange={(event) => setStream(event.target.value as Stream)}>
+                    <MenuItem value="screen">{t("Screen")}</MenuItem>
+                    {status?.webcam !== false && <MenuItem value="webcam">{t("Camera")}</MenuItem>}
+                </Select>
+                <ToggleButtonGroup
+                    size="small"
+                    color="primary"
+                    exclusive
+                    value={bottomBar}
+                    aria-label={t("Single-team bottom bar")}
+                    onChange={(_, next: TeamViewBottomBar | null) => next && setBottomBar(next)}
+                >
+                    <ToggleButton value="card">{t("School card")}</ToggleButton>
+                    <ToggleButton value="timeline">{t("Trend timeline")}</ToggleButton>
+                    <ToggleButton value="none">{t("Off")}</ToggleButton>
+                </ToggleButtonGroup>
+                <TextField size="small" label={t("Seat prefix")} value={seatPrefix} onChange={(event) => setSeatPrefix(event.target.value)}
+                    inputProps={{ list: "capture-zones" }} sx={{ width: 140 }} />
+                <datalist id="capture-zones">{zones.map((zone) => <option key={zone} value={zone} />)}</datalist>
+                <TextField size="small" label={t("Search")} value={search} onChange={(event) => setSearch(event.target.value)} />
+                <FormControlLabel control={<Switch checked={onlineOnly} onChange={(event) => setOnlineOnly(event.target.checked)} />} label={t("Online only")} />
+                {previews.size
+                    ? <Button variant="outlined" onClick={() => setPreviews(new Set())}>{t("Close previews")}</Button>
+                    : (
+                        <Button variant="outlined" disabled={!devices.some((device) => device.online && device.streams.includes(stream))}
+                            onClick={() => setPreviews(new Set(devices.filter((device) => device.online && device.streams.includes(stream)).slice(0, MAX_PREVIEWS).map((device) => device.id)))}>
+                            {t("Preview all")}
+                        </Button>
+                    )}
+                <Box sx={{ flex: 1 }} />
+                <Button variant="contained" color="error" onClick={offAir}>{t("Take team views off air")}</Button>
+            </Stack>
+            {status?.enabled === false && <Alert severity="warning" sx={{ mb: 2 }}>{t("Capture is not enabled for this contest. Enable it under 画面采集 in the contest's sidebar.")}</Alert>}
+            {screenBlocked && <Alert severity="warning" sx={{ mb: 2 }}>{t("Screens cannot go on air before the contest ends (capture settings).")}</Alert>}
+            {status && !status.devices.length && <Alert severity="info">{t("No capture devices yet.")}</Alert>}
+            <Box sx={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(280px, 1fr))", gap: 2 }}>
+                {devices.map((device) => {
+                    const has = device.streams.includes(stream);
+                    const disabled = !device.online || !has || !device.teamId || screenBlocked;
+                    return (
+                        <Card key={device.id} variant="outlined">
+                            <CardContent sx={{ pb: 1 }}>
+                                <Stack direction="row" spacing={1} alignItems="center" sx={{ mb: 1 }}>
+                                    <Typography variant="subtitle1" sx={{ fontWeight: 700, flex: 1, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
+                                        {device.teamName || device.name}
+                                    </Typography>
+                                    <Chip size="small" color={device.online ? "success" : "default"} label={device.online ? t("Online") : t("Offline")} />
+                                </Stack>
+                                <Typography variant="caption" color="text.secondary" component="div" sx={{ mb: 1 }}>
+                                    {[device.seat && `${t("Seat")} ${device.seat}`, device.name !== device.seat && device.name,
+                                        device.streams.map((item) => t(item === "screen" ? "Screen" : "Camera")).join(" · ")].filter(Boolean).join(" · ") || "—"}
+                                </Typography>
+                                {previews.has(device.id) && device.online && has
+                                    ? <Preview device={device.id} stream={stream} />
+                                    : (
+                                        <Box sx={{ aspectRatio: "16 / 9", borderRadius: 1, background: "rgba(0,0,0,.06)", display: "flex", alignItems: "center", justifyContent: "center" }}>
+                                            <Typography variant="caption" color="text.secondary">
+                                                {!device.online ? t("Offline") : !has ? t("Not capturing this") : !device.teamId ? t("No team for this device") : t("Preview off")}
+                                            </Typography>
+                                        </Box>
+                                    )}
+                            </CardContent>
+                            <CardActions sx={{ flexWrap: "wrap", gap: 1, px: 2, pb: 2 }}>
+                                <Button size="small" variant="contained" disabled={disabled} onClick={() => onAir(device, "SINGLE")}>{t("On air")}</Button>
+                                <ButtonGroup size="small" disabled={disabled} aria-label={t("Split screen")}>
+                                    {SPLIT.map((position, index) => (
+                                        <Button key={position} title={t("Split screen")} onClick={() => onAir(device, position)}>{`${t("Split")} ${index + 1}`}</Button>
+                                    ))}
+                                </ButtonGroup>
+                                <Button size="small" disabled={!device.online || !has} onClick={() => togglePreview(device.id)}>
+                                    {previews.has(device.id) ? t("Hide preview") : t("Preview")}
+                                </Button>
+                            </CardActions>
+                        </Card>
+                    );
+                })}
+            </Box>
+        </Container>
+    );
+};
+
+export default CapturePage;
