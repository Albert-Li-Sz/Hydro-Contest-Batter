+    top: 7px;
+    right: 12px;
+    z-index: 2;
+    pointer-events: none;
+    padding: 2px 9px;
+    border-radius: 999px;
+    font-family: "PingFang SC", "Microsoft YaHei", ${c.GLOBAL_DEFAULT_FONT_FAMILY}, sans-serif;
+    font-size: 13px;
+    font-weight: 600;
+    line-height: 1.4;
+    font-variant-numeric: tabular-nums;
+    color: ${(p) => (p.$darkText ? "#0F172A" : "#FFFFFF")};
+    background: ${(p) =>
+        p.$darkText ? "rgba(255, 255, 255, 0.55)" : "rgba(7, 19, 39, 0.42)"};
+    backdrop-filter: blur(2px);
+    white-space: nowrap;
+`;
+
+type Props = {
+    teamId: TeamId;
+    contestInfo: ContestInfo;
+    isPvp: boolean;
+    teamColor?: string;
+};
+
+type Point = [number, number];
+
+/** The trend is a step function (it only changes at a run): hold each value until the next change. */
+function stepPath(points: Point[]): string {
+    if (!points.length) return "";
+    const [x0, y0] = points[0];
+    return points
+        .slice(1)
+        .reduce((acc, [x, y]) => `${acc} H ${x.toFixed(1)} V ${y.toFixed(1)}`, `M ${x0.toFixed(1)} ${y0.toFixed(1)}`);
+}
+
+function scaleRankY(rank: number, teamsCount: number, topPad: number, bottomY: number): number {
+    const maxScale = Math.max(2, teamsCount);
+    const clamped = Math.max(1, Math.min(maxScale, rank));
+    const norm = (clamped - 1) / (maxScale - 1);
+    const scaled = maxScale > 20 ? Math.pow(norm, 0.65) : norm;
+    return topPad + scaled * (bottomY - topPad);
+}
+
+export function TeamTrendGraph({ teamId, contestInfo, isPvp, teamColor }: Props) {
+    const svgRef = useRef<SVGSVGElement | null>(null);
+    const [size, setSize] = useState({ w: 0, h: 0 });
+    const [trend, setTrend] = useState<TeamTrend | null>(null);
+    const [liveElapsed, setLiveElapsed] = useState<number>(() =>
+        calculateContestTime(contestInfo),
+    );
+
+    useEffect(() => {
+        if (!svgRef.current) return;
+        const ro = new ResizeObserver(([entry]) => {
+            const { width, height } = entry.contentRect;
+            setSize({ w: width, h: height });
+        });
+        ro.observe(svgRef.current);
+        return () => ro.disconnect();
+    }, []);
+
+    useEffect(() => {
+        const update = () => {
+            setLiveElapsed(
+                Math.max(
+                    0,
+                    Math.min(
+                        contestInfo.contestLengthMs,
+                        calculateContestTime(contestInfo),
+                    ),
+                ),
+            );
+        };
+        update();
+        const timer = setInterval(update, 1000);
+        return () => clearInterval(timer);
+    }, [contestInfo]);
+
+    useEffect(() => {
+        setTrend(null);
+        return followTeamChannel<TeamTrend | null>(`teamTrend/${teamId}`, (payload) => {
+            if (payload) setTrend(payload);
+        });
+    }, [teamId]);
+
+    const geometry = useMemo(() => {
+        const { w, h } = size;
+        if (!w || !h || !trend || !trend.points.length || contestInfo.contestLengthMs <= 0) {
+            return null;
+        }
+        const leftPad = c.TIMELINE_LEFT_TIME_PADDING;
+        const usableW = w * (isPvp ? c.TIMELINE_REAL_WIDTH_PVP : c.TIMELINE_REAL_WIDTH);
+        const topPad = isPvp ? 8 : 16;
+        const bottomPad = isPvp ? 6 : 10;
+        const bottomY = h - bottomPad;
+        const plotH = Math.max(10, bottomY - topPad);
+        const xOf = (time: number) =>
+            leftPad + (Math.max(0, Math.min(contestInfo.contestLengthMs, time)) / contestInfo.contestLengthMs) * usableW;
+        const maxProblems = Math.max(1, trend.problemsCount);
+        const ySolved = (solved: number) =>
+            bottomY - (Math.min(maxProblems, solved) / maxProblems) * plotH * 0.82;
+
+        // Extend the latest sample horizontally to the current live contest clock.
+        const points = [...trend.points];
+        const last = points[points.length - 1];
+        const endTime = Math.max(last.time, liveElapsed);
+        if (endTime > last.time + 1000) {
+            points.push({ ...last, time: endTime });
+        }
+
+        const solvedPts: Point[] = points.map((p) => [xOf(p.time), ySolved(p.solved)]);
+        const solvedLine = stepPath(solvedPts);
+        const solvedFill =
+            solvedPts.length > 0
+                ? `${solvedLine} V ${bottomY.toFixed(1)} H ${solvedPts[0][0].toFixed(1)} Z`
+                : "";
+
+        const frozenAt = trend.frozenAtMs;
+        let rankSolid = "";
+        let rankFrozen = "";
+        let rankEnd: Point | null = null;
+        if (trend.ranked) {
+            const rankedPts = points.filter((p) => p.rank > 0);
+            if (rankedPts.length > 0) {
+                if (frozenAt !== null && endTime > frozenAt) {
+                    const before = rankedPts.filter((p) => p.time <= frozenAt);
+                    const after = rankedPts.filter((p) => p.time >= frozenAt);
+                    if (before.length > 0) {
+                        const pre: Point[] = before.map((p) => [
+                            xOf(p.time),
+                            scaleRankY(p.rank, trend.teamsCount, topPad, bottomY),
+                        ]);
+                        const lastPre = before[before.length - 1];
+                        if (lastPre.time < frozenAt) {
+                            pre.push([
+                                xOf(frozenAt),
+                                scaleRankY(lastPre.rank, trend.teamsCount, topPad, bottomY),
+                            ]);
+                        }
+                        rankSolid = stepPath(pre);
+                        const postStart: Point = pre[pre.length - 1];
+                        const post: Point[] = [
+                            postStart,
+                            ...after
+                                .filter((p) => p.time > frozenAt)
+                                .map((p): Point => [
+                                    xOf(p.time),
+                                    scaleRankY(p.rank, trend.teamsCount, topPad, bottomY),
+                                ]),
+                        ];
+                        if (post.length === 1) {
+                            post.push([xOf(endTime), postStart[1]]);
+                        }
+                        rankFrozen = stepPath(post);
+                        rankEnd = post[post.length - 1];
+                    }
+                } else {
+                    const all: Point[] = rankedPts.map((p) => [
+                        xOf(p.time),
+                        scaleRankY(p.rank, trend.teamsCount, topPad, bottomY),
+                    ]);
+                    rankSolid = stepPath(all);
+                    rankEnd = all[all.length - 1];
+                }
+            }
+        }
+
+        const guideYs = [topPad, topPad + plotH * 0.5, bottomY];
+        return {
+            leftPad,
+            rightEdge: leftPad + usableW,
+            guideYs,
+            solvedLine,
+            solvedFill,
+            rankSolid,
+            rankFrozen,
+            rankEnd,
+            solvedEnd: solvedPts[solvedPts.length - 1] ?? null,
+            lastSolved: last.solved,
+        };
+    }, [size, trend, contestInfo.contestLengthMs, isPvp, liveElapsed]);
+
+    const useDark = isShouldUseDarkColor(teamColor ?? c.CONTEST_COLOR);
+    const guideStroke = useDark ? "rgba(0, 0, 0, 0.10)" : "rgba(255, 255, 255, 0.13)";
+    const solvedFillColor = useDark ? "rgba(0, 0, 0, 0.11)" : "rgba(255, 255, 255, 0.16)";
+    const solvedStrokeColor = useDark ? "rgba(0, 0, 0, 0.35)" : "rgba(255, 255, 255, 0.42)";
+    const rankStrokeColor = useDark ? "#0D3B7A" : "#FFE066";
+    const rankDotStroke = useDark ? "#FFFFFF" : "#0B2958";
+
+    const hudParts: string[] = [];
+    if (trend && geometry) {
+        if (trend.ranked && trend.currentRank !== null) {
+            hudParts.push(`${t("Rank")} #${trend.currentRank}`);
+            if (trend.bestRank !== null && trend.bestRank !== trend.currentRank) {
+                hudParts.push(`${t("Best")} #${trend.bestRank}`);
+            }
+        }
+        hudParts.push(`${t("Solved")} ${geometry.lastSolved}`);
+        if (trend.frozenAtMs !== null) hudParts.push("❄");
+    }
+
+    return (
+        <>
+            <TrendSvg
+                ref={svgRef}
+                className="TeamTrendGraph"
+                preserveAspectRatio="none"
+                aria-hidden="true"
+            >
+                {geometry && (
+                    <>
+                        {geometry.guideYs.map((y, index) => (
+                            <line
+                                key={index}
+                                x1={geometry.leftPad}
+                                x2={geometry.rightEdge}
+                                y1={y}
+                                y2={y}
+                                stroke={guideStroke}
+                                strokeWidth={1}
+                                strokeDasharray={index === 1 ? "4 4" : undefined}
+                            />
+                        ))}
+                        {geometry.solvedFill && (
+                            <path d={geometry.solvedFill} fill={solvedFillColor} />
+                        )}
+                        {geometry.solvedLine && (
+                            <path
+                                data-trend-solved
+                                d={geometry.solvedLine}
+                                fill="none"
+                                stroke={
+                                    trend?.ranked ? solvedStrokeColor : rankStrokeColor
+                                }
+                                strokeWidth={trend?.ranked ? 1.5 : 2.5}
+                                strokeLinejoin="miter"
+                                vectorEffect="non-scaling-stroke"
+                            />
+                        )}
+                        {geometry.rankSolid && (
+                            <path
+                                data-trend-rank
+                                d={geometry.rankSolid}
+                                fill="none"
+                                stroke={rankStrokeColor}
+                                strokeWidth={2.75}
+                                strokeLinejoin="round"
+                                strokeLinecap="round"
+                                vectorEffect="non-scaling-stroke"
+                            />
+                        )}
+                        {geometry.rankFrozen && (
+                            <path
+                                data-trend-frozen
+                                d={geometry.rankFrozen}
+                                fill="none"
+                                stroke={rankStrokeColor}
+                                strokeWidth={2.25}
+                                strokeDasharray="6 4"
+                                strokeOpacity={0.72}
+                                strokeLinejoin="round"
+                                strokeLinecap="round"
+                                vectorEffect="non-scaling-stroke"
+                            />
+                        )}
+                        {geometry.rankEnd && (
+                            <circle
+                                cx={geometry.rankEnd[0]}
+                                cy={geometry.rankEnd[1]}
+                                r={4.5}
+                                fill={rankStrokeColor}
+                                stroke={rankDotStroke}
+                                strokeWidth={1.5}
+                            />
+                        )}
+                        {!trend?.ranked && geometry.solvedEnd && geometry.lastSolved > 0 && (
+                            <circle
+                                cx={geometry.solvedEnd[0]}
+                                cy={geometry.solvedEnd[1]}
+                                r={4}
+                                fill={rankStrokeColor}
+                                stroke={rankDotStroke}
+                                strokeWidth={1.5}
+                            />
+                        )}
+                    </>
+                )}
+            </TrendSvg>
+            {!isPvp && hudParts.length > 0 && (
+                <TrendHud className="TeamTrendHud" $darkText={useDark}>
+                    {hudParts.join(" · ")}
+                </TrendHud>
+            )}
+        </>
+    );
+}
+
+export default TeamTrendGraph;
