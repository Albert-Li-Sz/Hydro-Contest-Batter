+                        <span style={{ flex: 1, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }} title={names[verdict.key] || verdict.label}>{verdict.code || names[verdict.key] || verdict.label}</span>
+                        <b style={{ fontVariantNumeric: "tabular-nums" }}>{verdict.count}</b>
+                    </div>
+                ))}
+            </div>
+        </div>
+    );
+}
