diff --git a/src/frontend/admin-configuration/src/components/atoms/TextCodeEditor.tsx b/src/frontend/admin-configuration/src/components/atoms/TextCodeEditor.tsx
new file mode 100644
index 0000000..e910553
--- /dev/null
+++ b/src/frontend/admin-configuration/src/components/atoms/TextCodeEditor.tsx
@@ -0,0 +1,51 @@
+import React, { useEffect, useState } from "react";
+
+// Hydro: the Monaco editor loads its code from a CDN, which venue networks often block.
+// A plain text area keeps the configuration pages usable offline.
+interface TextCodeEditorProps {
+    defaultValue: string;
+    onChange: (value: string) => void;
+    readonly: boolean;
+    validate?: (value: string) => string | null;
+}
+
+export function TextCodeEditor({
+    defaultValue,
+    onChange,
+    readonly,
+    validate,
+}: TextCodeEditorProps): React.ReactElement {
+    const [value, setValue] = useState(defaultValue);
+    useEffect(() => setValue(defaultValue), [defaultValue]);
+    const error = validate?.(value) ?? null;
+    return (
+        <div style={{ display: "flex", flexDirection: "column", height: "100%" }}>
+            <textarea
+                value={value}
+                readOnly={readonly}
+                spellCheck={false}
+                onChange={(event) => {
+                    setValue(event.target.value);
+                    onChange(event.target.value);
+                }}
+                style={{
+                    flex: 1,
+                    width: "100%",
+                    boxSizing: "border-box",
+                    fontFamily: "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
+                    fontSize: 13,
+                    lineHeight: 1.5,
+                    padding: 12,
+                    border: `1px solid ${error ? "#d32f2f" : "#c4c4c4"}`,
+                    borderRadius: 4,
+                    resize: "none",
+                }}
+            />
+            {error && (
+                <div style={{ color: "#d32f2f", fontSize: 13, marginTop: 4 }}>
+                    {error}
+                </div>
+            )}
+        </div>
+    );
+}
