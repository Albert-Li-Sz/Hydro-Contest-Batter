+                    <span style={{ opacity: 0.8 }}>{bin.teams || ""}</span>
+                    <div style={{ width: "100%", height: `${(bin.teams / top) * 70}%`, minHeight: bin.teams ? 3 : 0, background: c.CONTEST_COLOR, borderRadius: "3px 3px 0 0" }} />
+                    <span style={{ opacity: 0.6 }}>{bin.solved}</span>
+                </div>
+            ))}
+        </div>
+    );
+}
+
+function Verdicts({ verdicts, names }: { verdicts: NonNullable<Overview["verdicts"]>; names: Record<string, string> }) {
+    const total = verdicts.reduce((sum, verdict) => sum + verdict.count, 0);
+    const shown = verdicts.filter((verdict) => verdict.count);
+    return (
+        <div style={{ display: "flex", flexDirection: "column", gap: 8, flex: 1, minHeight: 0 }}>
+            <div style={{ display: "flex", height: 16, overflow: "hidden", borderRadius: 8, background: "rgb(255 255 255 / 8%)" }}>
